# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=gsk_your_key_here
# Optional extra keys: used in order when the previous key reaches its free-tier limit
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Optional overrides (defaults come from config.yaml)
# QDRANT_URL=http://127.0.0.1:6333
# HF_HOME=C:\precision-rag\hf_cache
# MODELS_DIR=C:\precision-rag\models
# DEVICE=cpu
# QDRANT_COLLECTION=msmarco_500k     # serve another collection (default: config.yaml)
